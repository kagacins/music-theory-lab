# Environment variables template
# Copy this to .env.local and fill in your values

# Google Custom Search API (for song chord search feature)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Get your Search Engine ID from: https://programmablesearchengine.google.com/
VITE_GOOGLE_SEARCH_API_KEY=your_api_key_here
VITE_GOOGLE_SEARCH_ENGINE_ID=your_engine_id_here
